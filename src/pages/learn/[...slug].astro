---
import {getCollection,render} from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import LessonControls from '../../components/LessonControls.astro';import {quizzes} from '../../data/quizzes';import {withBase} from '../../lib/urls';
export async function getStaticPaths(){const lessons=await getCollection('lessons');return lessons.map(lesson=>({params:{slug:lesson.data.id},props:{lesson}}));}
const {lesson}=Astro.props;const lessons=(await getCollection('lessons')).sort((a,b)=>a.data.order-b.data.order);const index=lessons.findIndex(({data})=>data.id===lesson.data.id);const previous=lessons[index-1];const next=lessons[index+1];const {Content}=await render(lesson);const lessonIds=lessons.map(({data})=>data.id);const quiz=quizzes[lesson.data.id];if(!quiz)throw new Error(`Missing quiz for ${lesson.data.id}`);
---
<BaseLayout title={lesson.data.title} description={lesson.data.description}><div class="page-shell"><header class="lesson-header"><span class="eyebrow">{lesson.data.phase} · MODULE {String(lesson.data.order).padStart(2,'0')}</span><h1>{lesson.data.title}</h1><p class="lead">{lesson.data.description}</p><p class="lesson-meta"><span>{lesson.data.estimatedMinutes} 分钟</span><span>{lesson.data.outcomes.length} 个明确产出</span></p></header><div class="lesson-layout"><article class="lesson-prose"><Content/><section class="sources"><span class="eyebrow">SOURCE TRAIL</span><h2>继续查证</h2><ul>{lesson.data.sourceLinks.map(source=><li><a href={source.url}>{source.label} ↗</a> <small>· {source.kind}</small></li>)}</ul></section><nav class="lesson-nav" aria-label="课程章节">{previous?<a href={withBase(`learn/${previous.data.id}/`)}>← {previous.data.title}</a>:<span></span>}{next?<a href={withBase(`learn/${next.data.id}/`)}>{next.data.title} →</a>:<a href={withBase('projects/')}>查看项目证据 →</a>}</nav></article><LessonControls lessonId={lesson.data.id} lessonIds={lessonIds} storageKey="vibeCodingLearningProgress.v1" quiz={quiz}/></div></div></BaseLayout>
